:8088 {
  encode zstd gzip

  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    X-Frame-Options "DENY"
    Cross-Origin-Opener-Policy "same-origin"
  }

  @public_client_api {
    method POST OPTIONS
    path /api/relay/resolve /api/relay/reserve-tokens /api/relay/abandon-replica-placements
  }

  handle @public_client_api {
    reverse_proxy registry:8080
  }

  @public_block_api {
    method GET PUT OPTIONS
    path_regexp block ^/block/[0-9a-fA-F]{64}$
  }

  handle @public_block_api {
    uri strip_prefix /block
    reverse_proxy relay:9090
  }

  @blocked_control_plane {
    path /api/* /health /block/*
  }

  handle @blocked_control_plane {
    respond "Not found" 404
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
