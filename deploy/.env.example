# A DNS name pointing at the server. Caddy obtains and renews HTTPS automatically.
PUBLIC_HOST=share.example.com
PUBLIC_ORIGIN=https://share.example.com
CONSOLE_PORT=8070

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
REGISTRY_ADMIN_API_KEY=REPLACE_WITH_RANDOM_SECRET
RELAY_ADMIN_API_KEY=REPLACE_WITH_RANDOM_SECRET
REGISTRY_BLOCK_AUTH_MASTER_KEY=REPLACE_WITH_RANDOM_SECRET
