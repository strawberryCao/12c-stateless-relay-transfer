FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    STATELESS_RELAY_SERVER_CONFIG=/run/12c/relay_server.config.json

RUN useradd --system --uid 10001 --create-home app
WORKDIR /app/server

COPY server/local_secrets ./local_secrets
COPY server/relay/requirements.txt ./relay/requirements.txt
RUN pip install -r ./relay/requirements.txt
COPY server/relay ./relay
COPY deploy/render_config.py /opt/12c/render_config.py
COPY deploy/config/relay_server.config.template.json /opt/12c/config/relay_server.config.template.json
COPY deploy/entrypoints/relay.sh /usr/local/bin/relay-entrypoint

RUN sed -i 's/\r$//' /usr/local/bin/relay-entrypoint \
    && chmod 0755 /usr/local/bin/relay-entrypoint \
    && mkdir -p /data /run/12c \
    && chown -R app:app /data /run/12c /app/server

USER app
WORKDIR /app/server/relay

EXPOSE 9090
ENTRYPOINT ["/usr/local/bin/relay-entrypoint"]